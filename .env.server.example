# SERVER ONLY. Never prefix these with VITE_. Never commit the filled file.
SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=
CONSUMER_ORIGIN=http://127.0.0.1:5173
ATTACHMENT_PORT=8787

# Enterprise provisioning/login and future hosted checkout; SERVER ONLY.
PLATFORM_APP_ORIGIN=http://127.0.0.1:5173
PLATFORM_API_PORT=8788
# Mercado Pago subscriptions: disabled until owner test homologation.
BILLING_PROVIDER=mercado_pago

# Optional historical e-mail delivery route; normal 034 creation/resume/reissue is manual.
# No SMTP is required for first access. This is not a Supabase Auth invite.
# Disabled until the owner configures an SMTP provider. No connection on startup.
ACCESS_MAIL_ENABLED=false
ACCESS_SMTP_HOST=
ACCESS_SMTP_PORT=587
ACCESS_SMTP_USER=
ACCESS_SMTP_PASSWORD=
ACCESS_MAIL_FROM=
# PLATFORM_APP_ORIGIN above is also the official /entrar link. Never set these as VITE_*.

# SERVER ONLY. Leave blank in this package; no real credentials in local tests.
BILLING_API_PORT=8789
MERCADO_PAGO_ENABLED=false
# Homologation only. disabled (default) | observe (HMAC + official reads, no effects).
# Keep ENABLED=false; observe also requires BILLING_PROVIDER=mercado_pago and a valid
# MERCADO_PAGO_WEBHOOK_SECRET. Never remove/change the secret just to pass a test.
# User commands, trial/capabilities and reconciliation remain disabled in observe.
MERCADO_PAGO_NOTIFICATION_MODE=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_NOTIFICATION_URL=
# Subscription resource notification hints always require official API verification.
MERCADO_PAGO_NOTIFICATION_AUTH=resource_lookup
# Optional only when a valid HMAC signing secret applies to the notification mechanism.
MERCADO_PAGO_WEBHOOK_SECRET=

# 048 unified entry: npm start uses hosting environment; api:dev reads .env.server.
PORT=10000
HOST=0.0.0.0
# Same 047 reconciler, in-process and only when Mercado Pago is enabled.
BILLING_RECONCILE_INTERVAL_SECONDS=300
# Planned hosting: PLATFORM_APP_ORIGIN=https://app.usesyzia.com.br
# CONSUMER_ORIGIN=https://app.usesyzia.com.br
# MERCADO_PAGO_NOTIFICATION_URL=https://api.usesyzia.com.br/billing/notifications
# MP-01 remains open. Do not enable Mercado Pago without external test homologation.

# Commercial control plane / dedicated demo data. No connection when disabled.
COMMERCIAL_ENABLED=false
COMMERCIAL_MAIL_ENABLED=false
COMMERCIAL_DEMO_ORIGIN=
COMMERCIAL_CONTACT_EMAIL=
COMMERCIAL_LINK_ENCRYPTION_KEY=
COMMERCIAL_BATCH_LIMIT=25
COMMERCIAL_INVITE_DAYS=7
# Separate PostgreSQL only; NEVER use the operational Supabase database.
DEMO_DATABASE_URL=
DEMO_DATABASE_PURPOSE=
DEMO_SESSION_MINUTES=60
DEMO_MAX_VISITORS=200
DEMO_MAX_INSTANCES=1000
# Existing ACCESS_MAIL_* / ACCESS_SMTP_* settings are reused.
