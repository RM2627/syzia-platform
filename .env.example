# Only the URL and PUBLISHABLE (or legacy anon) key belong in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Gateway privado executado localmente; nenhuma chave privilegiada aqui.
VITE_ATTACHMENT_GATEWAY_URL=http://127.0.0.1:8787
# Opcional: chave PÚBLICA do Turnstile. Secret somente no painel Supabase.
VITE_TURNSTILE_SITE_KEY=

# Public URL only. No privileged credential. Required for enterprise login/provisioning.
VITE_PLATFORM_API_URL=http://127.0.0.1:8788

# Optional safe operation diagnostics. Never logs credentials or form payloads.
VITE_AUTH_DIAGNOSTICS=false

# Optional institutional canonical origin; leave empty until the real domain is defined.
VITE_PUBLIC_SITE_URL=

# Public address only; Access Token must NEVER be a VITE_* variable.
VITE_BILLING_API_URL=http://127.0.0.1:8789

# 048 single-port local mode: set all three API URLs above to http://127.0.0.1:10000
# Planned hosting: all three API URLs = https://api.usesyzia.com.br
# Planned institutional origin: VITE_PUBLIC_SITE_URL=https://usesyzia.com.br

# Gestão Comercial 054: disabled until local homologation and owner integration.
VITE_COMMERCIAL_PREPARATION_ENABLED=false
VITE_COMMERCIAL_API_URL=
VITE_COMMERCIAL_DEMO_ORIGIN=
