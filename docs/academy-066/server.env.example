# Merge into the existing server environment; do not replace it. No filled secrets in Git.
ACADEMY_ENABLED=false
ACADEMY_PUBLIC_ORIGIN=http://127.0.0.1:5175
# Separate random 32-byte key, hex encoded (64 characters), server-only.
ACADEMY_SECRET=
ACADEMY_MAIL_ENABLED=false
# Reuses existing ACCESS_MAIL_ENABLED / ACCESS_SMTP_* / ACCESS_MAIL_FROM.
# These are Academy budgets, not a discovery of the provider/account quota.
ACADEMY_MAIL_DAILY_LIMIT=80
ACADEMY_MAIL_MONTHLY_LIMIT=2400
# false uses the TCP peer; true trusts only the last X-Forwarded-For added by a verified proxy.
# Validate the hosting ingress before enabling. Never trust arbitrary client headers.
ACADEMY_TRUST_PROXY=false
